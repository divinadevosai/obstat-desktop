{
  "name": "obstat-desktop",
  "productName": "Obstat",
  "version": "0.1.0",
  "private": true,
  "description": "Install and run reviewed AI apps with one click.",
  "desktopName": "obstat.desktop",
  "author": "SWE3WE <hello@swe3we.dev>",
  "license": "MIT",
  "repository": "github:divinadevosai/obstat-desktop",
  "main": "main.js",
  "scripts": {
    "sync": "node scripts/sync.js",
    "prestart": "npm run sync",
    "start": "electron .",
    "predist": "npm run sync",
    "dist": "electron-builder --win --publish never",
    "test": "node --test --test-timeout=120000 test/*.test.js",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "predist:mac": "npm run sync",
    "predist:linux": "npm run sync && node scripts/bwrap.js"
  },
  "build": {
    "appId": "dev.swe3we.obstat",
    "productName": "Obstat",
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "app/**",
      "skills/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://obstat.app/update"
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Obstat-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "Obstat-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "maintainer": "SWE3WE <hello@swe3we.dev>",
      "synopsis": "Install and run AI apps with one click",
      "artifactName": "Obstat-${version}-linux-${arch}.${ext}",
      "syncDesktopName": true,
      "extraResources": [
        {
          "from": "build/linux/bwrap",
          "to": "bwrap"
        },
        {
          "from": "build/linux/bwrap-LICENSE.txt",
          "to": "bwrap-LICENSE.txt"
        }
      ]
    },
    "protocols": [
      {
        "name": "Obstat",
        "schemes": [
          "obstat"
        ]
      }
    ],
    "deb": {
      "appArmorProfile": "build/linux/apparmor-profile.tpl"
    }
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "js-yaml": "^4.3.2",
    "semver": "^7.8.5"
  }
}
